NODE_ENV=development
# Docker Compose password must match DATABASE_URL. Never commit backend/.env.
POSTGRES_PASSWORD=CHANGE_ME
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://energotransport:CHANGE_ME@127.0.0.1:5432/energotransport
# Must name a separate disposable database ending in _test. Tests isolate each run in its own schema.
TEST_DATABASE_URL=postgresql://energotransport:CHANGE_ME@127.0.0.1:5432/energotransport_test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_TTL_SECONDS=604800
# Production: exact HTTPS origin, TRUST_PROXY_HOPS=1 behind Render, TLS verify-full.
# Keep URLs only in provider environment. Direct URL is used for migrations.
# DATABASE_URL_UNPOOLED=postgresql://...?...sslmode=verify-full
TRUST_PROXY_HOPS=0
PUBLIC_DEMO=false
DEPLOY_SEED=false
# Optional test provider: set BOTH. Origin must be HTTPS and point to this API (local TLS reverse proxy for local checkout).
# PAYMENT_PUBLIC_ORIGIN=https://your-api.onrender.com
# PAYMENT_WEBHOOK_SECRET=generate-a-private-random-key-at-least-32-characters
# Only for explicit local seed; no default passwords in application code.
SEED_OPERATOR_PASSWORD=
SEED_DRIVER_PASSWORD=
# Used only by npm run operator:create, never a public registration parameter.
OPERATOR_EMAIL=
OPERATOR_NAME=
OPERATOR_PASSWORD=
OPERATOR_ORGANIZATION_ID=

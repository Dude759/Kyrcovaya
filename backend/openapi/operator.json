                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "address": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 300
                  },
                  "district": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "coordinates": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,

                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "maxPowerKw": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.01
                  },
                  "limitKw": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.01
                  },
                  "pricePerKwh": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000,
                    "multipleOf": 0.01
                  },
                  "status": {
                    "enum": [
                      "online",

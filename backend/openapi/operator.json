          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "address": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 300
                  },
                  "district": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "coordinates": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "maxPowerKw": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.01
                  },
                  "limitKw": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.01
                  },
                  "pricePerKwh": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000,
                    "multipleOf": 0.01
                  },
                  "status": {
                    "enum": [
                      "online",
                      "service",
                      "offline"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/operator/stations/{id}/connectors": {
      "post": {
        "summary": "Добавить физический порт",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }

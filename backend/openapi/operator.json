{
  "openapi": "3.1.0",
  "info": {
    "title": "Энерготранспорт — Operator Management",
    "version": "0.10.0",
    "description": "Идемпотентность org/key/payload. Финансовые снимки неизменны; архив сохраняет историю. Локальные лимиты не являются управлением энергосистемой."
  },
  "servers": [
    {
      "url": "https://energotransport-api-dude759.onrender.com/api"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/operator/stations": {
      "post": {
        "summary": "Создать учебную станцию в service",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Согласованный результат; событие аудита записано атомарно"
          },
          "400": {
            "description": "Неверный JSON/координаты/мощность/тариф"
          },
          "401": {
            "description": "Требуется Bearer"
          },
          "403": {
            "description": "Только operator"
          },
          "404": {
            "description": "Чужой/отсутствующий объект"
          },
          "409": {
            "description": "Резерв, сессия, история, лимит либо конфликт ключа"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "address": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 300
                  },
                  "district": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "coordinates": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "maxPowerKw": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.01
                  },
                  "limitKw": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.01
                  },
                  "pricePerKwh": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000,
                    "multipleOf": 0.01
                  }
                },
                "required": [
                  "name",
                  "address",
                  "coordinates",
                  "maxPowerKw",
                  "limitKw",
                  "pricePerKwh"
                ]
              }
            }
          }
        }
      },
      "get": {
        "summary": "Станции организации, включая архив",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Согласованный результат; событие аудита записано атомарно"
          },
          "400": {
            "description": "Неверный JSON/координаты/мощность/тариф"
          },
          "401": {
            "description": "Требуется Bearer"
          },
          "403": {
            "description": "Только operator"
          },
          "404": {
            "description": "Чужой/отсутствующий объект"
          },
          "409": {
            "description": "Резерв, сессия, история, лимит либо конфликт ключа"
          }
        }
      }
    },

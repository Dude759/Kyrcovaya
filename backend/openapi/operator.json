              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scenario"
                ],
                "properties": {
                  "scenario": {
                    "enum": [
                      "normal",
                      "deficit",
                      "deep_deficit",
                      "recovery",
                      "offline",
                      "stale",
                      "missing"
                    ]
                  },
                  "workload": {
                    "enum": [
                      "live",
                      "training"
                    ],
                    "default": "live"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/operator/power/plan": {
      "get": {
        "summary": "Shadow plan separate from current Grid; usable=false when stale; requested/planned/acknowledged/measured W, training distinct from live",
        "responses": {
          "200": {
            "description": "Simulator data / shadow calculation, never applied to devices"
          },
          "400": {
            "description": "Invalid strict input"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Organization operator only"
          },
          "409": {
            "description": "Idempotency conflict"
          }
        }
      }
    },
    "/operator/power/dispatch": {
      "get": {
        "operationId": "getPowerDispatch",
        "summary": "Current requested / planned / acknowledged / measured simulator power, commands and reconciliation",
        "responses": {
          "200": {
            "description": "Own organization only. enabled defaults false; budgetW null means unknown. Acknowledged is durable last receipt, never a pending target. Fresh measuredW may be null. History is calculation-time evidence."
          },
          "403": {
            "description": "Operator only"
          }
        }
      },
      "post": {
        "operationId": "setPowerDispatchMode",
        "summary": "Controlled simulator mode switch, only without unfinished sessions or commands",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current mode and snapshot; audited org/key replay. New sessions enrolled, existing sessions never migrated."
          },
          "400": {
            "description": "Invalid strict input"
          },
          "403": {
            "description": "Own organization operator only"
          },
          "409": {
            "description": "Unfinished sessions/commands, unknown/nonpositive/training Grid, or key reused for another mode"
          }
        }
      }
    }
  }
}

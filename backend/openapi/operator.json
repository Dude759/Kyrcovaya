          "404": {
            "description": "Чужой/отсутствующий объект"
          },
          "409": {
            "description": "Резерв, сессия, история, лимит либо конфликт ключа"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "type": {
                    "enum": [
                      "CCS2",
                      "CHAdeMO",
                      "Type 2"
                    ]
                  },
                  "maxPowerKw": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000000,
                    "multipleOf": 0.01
                  },
                  "status": {
                    "enum": [
                      "idle",
                      "service",
                      "offline"
                    ]
                  }
                },
                "required": [
                  "label",
                  "type",
                  "maxPowerKw",
                  "status"
                ]
              }
            }
          }
        }
      },
      "get": {
        "summary": "Порты своей станции, включая архив",

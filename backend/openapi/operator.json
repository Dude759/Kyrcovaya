    "/operator/monitoring": {
      "get": {
        "summary": "Organization simulator readings, nullable full load, subset and allocated W, session status counts, measured Wh, settled test kopecks, null grid budget",
        "description": "Source simulator only. Organization from Bearer identity. History max31days, keyset pagination. Unknown values null, never invented zeros. UTC strict-adjacent-v1 excludes cross-hour and gap interpolation. Units W / Wh / kopecks.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Consistent read snapshot; list items and nextCursor where paginated"
          },
          "400": {
            "description": "Strict query invalid"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Operator role required"
          },
          "404": {
            "description": "Station outside organization"
          }
        }
      }
    },

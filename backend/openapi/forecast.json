    "schemas": {
      "ForecastBundle": {
        "type": "object",
        "required": [
          "organizationId",
          "source",
          "mode",
          "origin",
          "generatedAt",
          "modelVersion",
          "quality",
          "datasetHash",
          "metrics",
          "points"
        ],
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "const": "synthetic"
          },
          "mode": {
            "const": "historical_replay"
          },
          "origin": {
            "type": "string",
            "format": "date-time"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "modelVersion": {
            "type": "string"
          },
          "quality": {
            "const": "synthetic_experiment_only"
          },
          "datasetHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "points": {
            "type": "array",
            "minItems": 24,
            "maxItems": 24,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "h",
                "time",
                "powerKw",
                "lastKw",
                "weeklyKw"
              ],
              "properties": {
                "h": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 24
                },
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "powerKw": {
                  "type": "number",
                  "minimum": 0
                },
                "lastKw": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "weeklyKw": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "validation": {
                "type": "object",
                "required": [
                  "aggregate",
                  "origins",
                  "pairs",

  "paths": {
    "/operator/forecast": {
      "get": {
        "summary": "Actual readiness; no verified actual model",
        "responses": {
          "400": {
            "description": "Strict query: no unknown parameters"
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "Operator required"
          },
          "200": {
            "description": "Own organization readiness",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "readiness",
                    "source",
                    "forecast",
                    "reason",
                    "quality",
                    "asOf",
                    "mode"
                  ],
                  "properties": {
                    "status": {
                      "const": "insufficient_data"
                    },
                    "readiness": {
                      "const": "NEEDS_MORE_DATA"
                    },
                    "source": {
                      "const": "actual"
                    },
                    "forecast": {
                      "type": "null"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "quality": {
                      "type": "object",
                      "properties": {
                        "completeStationHours": {
                          "type": "integer"
                        },
                        "stationHours": {
                          "type": "integer"
                        }
                      }
                    },
                    "asOf": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "mode": {
                      "const": "offline_only"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Unsupported in offline replay architecture",
        "responses": {
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "Operator required"
          },
          "501": {
            "description": "New Python calculation requires reviewed versioned artifact; nothing enqueued"
          }
        }
      }
    },
    "/operator/forecast/demo": {
      "get": {
        "summary": "Own organization immutable historical experiment",
        "responses": {
          "400": {
            "description": "Strict query: no unknown parameters"
          },
          "401": {
            "description": "Bearer required"
          },
          "403": {
            "description": "Operator required"
          },
          "404": {
            "description": "No experiment of this organization"
          },
          "503": {
            "description": "Artifact not published or checksum/DB points mismatch"
          },
          "200": {
            "description": "Historical replay, not a forecast for today",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "historical",
                    "staleForCurrentNetwork",
                    "forecast",
                    "warning"
                  ],
                  "properties": {
                    "status": {
                      "const": "ready"
                    },
                    "historical": {
                      "const": true
                    },
                    "staleForCurrentNetwork": {
                      "const": true
                    },
                    "forecast": {
                      "$ref": "#/components/schemas/ForecastBundle"
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

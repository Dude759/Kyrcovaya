                  "coverage",
                  "horizons"
                ],
                "properties": {
                  "aggregate": {
                    "type": "object",
                    "required": [
                      "rf",
                      "last",
                      "weekly"
                    ],
                    "properties": {
                      "rf": {
                        "type": "object",
                        "required": [
                          "n",
                          "mae_kw",
                          "rmse_kw"
                        ],
                        "properties": {
                          "n": {

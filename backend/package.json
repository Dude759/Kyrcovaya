{
  "name": "energotransport-backend",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:public": "node dist/src/deploy.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx seeds/run.ts",
    "operator:create": "tsx src/modules/users/create-operator.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}

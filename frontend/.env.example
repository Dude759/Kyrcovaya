# mock — локальная демонстрация; http — подключение сервера по контракту из docs
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# Браузерный ключ JavaScript API 3.0 из кабинета разработчика Яндекс
VITE_YANDEX_MAPS_API_KEY=

# GitHub Pages: hash; обычный сервер: browser
VITE_ROUTER_MODE=browser
# GitHub Pages для проекта: /имя-репозитория/; локально: /
VITE_BASE_PATH=/
